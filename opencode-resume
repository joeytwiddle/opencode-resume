#!/usr/bin/env bash
# vim: filetype=sh ts=2 sw=2 expandtab
#
# opencode-resume — an fzf picker for opencode sessions from any folder.
#
# Browse your recent opencode sessions in a fuzzy-searchable list, preview the
# conversation in the side pane, then hit Enter to resume one with
# `opencode -s <id>`. You can also rename or delete sessions inline, and
# search and view full transcripts.
#
# Usage: opencode-resume [flags] [mode] [search query]
#
# MODES
#   (default)                  Open the interactive fzf picker — browse, search,
#                              preview, resume, rename, and delete sessions
#   -S, --search [<terms>]     Shows only sessions where the provided terms
#                              appear in the transcript.
#   -t, --transcript           View selected transcript instead of resuming
#   -t, --transcript <id|name> View the transcript for the given session
#   -a, --all-transcripts [r]  Dump transcripts for all sessions
#                              With regex, filters session list by name/dir/etc
#   -e, --edit                 Open selected transcript instead of resuming
#   -e, --edit <id|name>       Open transcript; prompts for editor (or saved default)
#   -r, --resume <id|name|t>   Resume directly by sid, exact name, or search term
#   -l, --list                 Just print the list of sessions
#
# WHICH SESSIONS TO LIST
#   --recent (default)         Most recent sessions across every folder, flat
#   -d, --here, --this         Only sessions for the current folder
#   -g, --group, --both        "This folder" sessions first, "Recent" after
#   --max-sessions N           Cap to N newest sessions (default 300)
#   --max-age-days N           Drop sessions older than N days (default 90)
#
# RESUME OPTIONS
#   --no-tmux-rename           Don't rename the tmux window to the session title
#
# TRANSCRIPT DETAIL
#   (default)                  All messages, full bodies, no tool blocks
#   --short                    Compact: first N + last N, one line each
#   --first N                  (with --short) First N messages shown (default 15)
#   --last N                   (with --short) Last N messages shown (default 15)
#   --with-tools, --full, -f   (without --short) Include tool_use / tool_results
#   -T, --timestamps           Show timestamp before each message
#   --transcript-style <mode>  Sets which colour styling is applied to transcripts
#                              Modes: both (default) | chat | bat | none
#
# STYLING (environment variables)
#   OPENCODE_RESUME_TRANSCRIPT_STYLING   as above: both (default) | chat | bat | none
#   You can customise colours for each role as ANSI body (between "\033[" and "m")
#   OPENCODE_RESUME_STYLE_META           OPENCODE_RESUME_STYLE_TIMESTAMP
#   OPENCODE_RESUME_STYLE_USER           OPENCODE_RESUME_STYLE_ASSISTANT
#   OPENCODE_RESUME_STYLE_TOOL_TAG       OPENCODE_RESUME_STYLE_TOOL_USE
#   OPENCODE_RESUME_STYLE_TOOL_RESULT    OPENCODE_RESUME_STYLE_SKIPPED
#   OPENCODE_RESUME_STYLE_SEARCH_SEPARATOR
#
# CONFIG FILE
#   ${XDG_CONFIG_HOME:-$HOME/.config}/opencode-resume/config
#   Sourced bash file. Put OPENCODE_RESUME_STYLE_* or other env var overrides
#   there instead of .bashrc. CLI flags still take precedence.
#
# EXAMPLES
#   opencode-resume              # most-recent across all folders
#   opencode-resume --this       # only this folder
#   opencode-resume --both       # grouped listing
#   opencode-resume -l           # plain list
#   opencode-resume -r ses_xxx   # resume directly
#   opencode-resume -tfT sess2   # dump transcript including tools and times
#   opencode-resume -a foo       # dump all transcripts with "foo" in title/dir
#   opencode-resume -S bar baz   # search for sessions mentioning "bar" and "baz"

set -euo pipefail

config_file="${XDG_CONFIG_HOME:-$HOME/.config}/opencode-resume/config"
if [ -f "$config_file" ]; then
  source "$config_file"
fi
unset config_file

OPENCODE_DB="${OPENCODE_DB:-}"
MAX_SESSIONS="${OPENCODE_RESUME_MAX_SESSIONS:-300}"
MAX_AGE="${OPENCODE_RESUME_MAX_AGE-90}"

OPENCODE_RESUME_TRANSCRIPT_STYLING="${OPENCODE_RESUME_TRANSCRIPT_STYLING:-both}"
OPENCODE_RESUME_PREVIEW_FIRST="${OPENCODE_RESUME_PREVIEW_FIRST:-15}"
OPENCODE_RESUME_PREVIEW_LAST="${OPENCODE_RESUME_PREVIEW_LAST:-15}"
OPENCODE_RESUME_TRANSCRIPT_PICKER="${OPENCODE_RESUME_TRANSCRIPT_PICKER:-}"
OPENCODE_RESUME_EDIT_PICKER="${OPENCODE_RESUME_EDIT_PICKER:-}"

ellipsis=$'\u2026'
bullet=$'  \u2022  '

init_picker_state() {
  OPENCODE_RESUME_PREVIEW_LAYOUT_FILE="$(mktemp -u "${TMPDIR:-/tmp}/opencode-resume-layout-XXXXXX")"
  export OPENCODE_RESUME_LIST_WITH_SID=1
  export FORCE_COLOR="${FORCE_COLOR:-1}"
  if [ -n "${1:-}" ]; then
    OPENCODE_RESUME_GROUP_TOGGLE="$(mktemp -u "${TMPDIR:-/tmp}/opencode-resume-group-XXXXXX")"
    export OPENCODE_RESUME_PREVIEW_LAYOUT_FILE OPENCODE_RESUME_GROUP_TOGGLE
    trap 'rm -f "${OPENCODE_RESUME_PREVIEW_LAYOUT_FILE:-}" "${OPENCODE_RESUME_GROUP_TOGGLE:-}"' EXIT
  else
    export OPENCODE_RESUME_PREVIEW_LAYOUT_FILE
    trap 'rm -f "${OPENCODE_RESUME_PREVIEW_LAYOUT_FILE:-}"' EXIT
  fi
}

parse_fzf_result() {
  local out="$1"
  CR_FZF_KEY="$(printf '%s\n' "$out" | sed -n '1p')"
  CR_FZF_SESSION_IDS=()
  local line sid
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    sid="$(printf '%s' "$line" | cut -f1)"
    [ -n "$sid" ] && CR_FZF_SESSION_IDS+=("$sid")
  done < <(printf '%s\n' "$out" | tail -n +2)

  if [ "$CR_FZF_KEY" = "ctrl-n" ]; then
    rm -f "${OPENCODE_RESUME_PREVIEW_LAYOUT_FILE:-}" "${OPENCODE_RESUME_GROUP_TOGGLE:-}"
    unset OPENCODE_RESUME_PREVIEW_LAYOUT_FILE OPENCODE_RESUME_GROUP_TOGGLE \
          OPENCODE_RESUME_LIST_WITH_SID
    exec opencode
  fi
}

color_reset=''  color_bold=''  color_unbold=''  color_dim=''  color_el=''
color_cyan=''   color_green=''  color_green_bold=''  color_blue_bold=''  color_yellow_bold=''
color_red=''    color_red_bold=''  color_white_bold=''  color_meta=''
color_user=''   color_assistant=''  color_tool_tag=''  color_tool_use=''  color_tool_result=''
color_skipped=''  color_search_separator=''  color_timestamp=''

init_colors() {
  { want_color && our_styling; } || return 0
  color_reset=$'\033[0m'
  color_bold=$'\033[1m'
  color_unbold=$'\033[22m'
  color_dim=$'\033[2m'
  color_el=$'\033[K'
  color_cyan=$'\033[36m'
  color_green=$'\033[32m'
  color_green_bold=$'\033[1;32m'
  color_blue_bold=$'\033[1;34m'
  color_yellow_bold=$'\033[1;33m'
  color_red=$'\033[31m'
  color_red_bold=$'\033[1;31m'
  color_white_bold=$'\033[1;37m'
  color_meta="$(printf '\033[%sm' "${OPENCODE_RESUME_STYLE_META:-38;5;250}")"
  color_user="$(printf '\033[%sm' "${OPENCODE_RESUME_STYLE_USER:-48;5;22;97}")"
  color_assistant="${OPENCODE_RESUME_STYLE_ASSISTANT+$(printf '\033[%sm' "$OPENCODE_RESUME_STYLE_ASSISTANT")}"
  color_tool_tag="$(printf '\033[%sm' "${OPENCODE_RESUME_STYLE_TOOL_TAG:-38;5;12}")"
  color_tool_use="$(printf '\033[%sm' "${OPENCODE_RESUME_STYLE_TOOL_USE:-38;5;250}")"
  color_tool_result="$(printf '\033[%sm' "${OPENCODE_RESUME_STYLE_TOOL_RESULT:-38;5;246}")"
  color_skipped="$(printf '\033[%sm' "${OPENCODE_RESUME_STYLE_SKIPPED:-38;5;35}")"
  color_search_separator="$(printf '\033[%sm' "${OPENCODE_RESUME_STYLE_SEARCH_SEPARATOR:-1;97;48;5;18}")"
  color_timestamp="$(printf '\033[%sm' "${OPENCODE_RESUME_STYLE_TIMESTAMP:-2}")"
}

our_styling() {
  case "$OPENCODE_RESUME_TRANSCRIPT_STYLING" in both|chat) ;; *) return 1 ;; esac
  local var key val
  for var in color_cyan color_green color_green_bold color_blue_bold color_yellow_bold color_red color_red_bold color_white_bold color_dim color_meta; do
    key="OPENCODE_RESUME_STYLE_$(printf '%s' "$var" | tr '[:lower:]' '[:upper:]')"
    eval "val=\"\${$key:-}\""
    [ -n "$val" ] && eval "$var=\"\$(printf '\\033[%sm' \"\$val\")\""
  done
  return 0
}

bat_styling() {
  case "$OPENCODE_RESUME_TRANSCRIPT_STYLING" in both|bat) return 0 ;; *) return 1 ;; esac
}

render() {
  if bat_styling && command -v bat >/dev/null 2>&1; then
    bat -l markdown --style=plain --color=always
  else
    cat
  fi
}

# Session ID validation — prevent SQL injection
validate_sid() {
  local sid="$1"
  [[ "$sid" =~ ^ses_[a-zA-Z0-9_]+$ ]] && return 0
  return 1
}

# Preview mode file: stores the current transcript preview mode
preview_mode_file() {
  local f="${OPENCODE_RESUME_PREVIEW_MODE_FILE:-}"
  if [ -z "$f" ]; then
    echo "conversation"
    return 0
  fi
  if [ "${1:-}" = "cycle" ]; then
    case "$(cat "$f" 2>/dev/null)" in
      short)       echo conversation > "$f" ;;
      conversation) echo full > "$f" ;;
      *)           echo short > "$f" ;;
    esac
  fi
  cat "$f" 2>/dev/null || echo "conversation"
}

# Preview mode spec: which preview modes exist and default
preview_mode_spec() {
  case "$(preview_mode_file)" in
    short)       echo "short transcript" ;;
    conversation) echo "conversation" ;;
    full)        echo "full transcript" ;;
  esac
}

# Session transcript cache — renders to $TMPDIR/opencode-resume/preview-cache/
# with lazy invalidation (only re-renders when source data is newer).
session_transcript_cache() {
  local sid="$1" short="${2:-false}" full="${3:-false}" timestamps="${4:-false}"
  local tmpdir="${TMPDIR:-/tmp}"
  local cache_dir="$tmpdir/opencode-resume/preview-cache"
  mkdir -p "$cache_dir" 2>/dev/null || true

  local mode_tag="conv"
  [ "$short" = "true" ] && mode_tag="short"
  [ "$full" = "true" ] && mode_tag="full"
  [ "$timestamps" = "true" ] && mode_tag="${mode_tag}_ts"

  local cache_file="$cache_dir/${sid}_${mode_tag}.md"
  local db
  db="$(get_db_path)" || return 1

  local session_updated
  session_updated="$(open_query "$db" "SELECT COALESCE(time_updated, 0) FROM session WHERE id = '$sid'")"

  if [ -f "$cache_file" ] && [ -n "$session_updated" ]; then
    local cache_mtime session_mtime
    cache_mtime="$(stat -c %Y "$cache_file" 2>/dev/null || echo 0)"
    session_mtime=$(( session_updated / 1000 ))
    [ "$cache_mtime" -gt "$session_mtime" ] 2>/dev/null && { printf '%s' "$cache_file"; return 0; }
  fi

  render_transcript_impl "$sid" "$short" "$full" "$timestamps" > "$cache_file" 2>/dev/null
  printf '%s' "$cache_file"
}

# ──────────────────────────────────────────────
# Core transcript rendering
# ──────────────────────────────────────────────
render_transcript_impl() {
  local sid="$1" short_mode="${2:-false}" full_mode="${3:-false}" ts_mode="${4:-false}"
  local first_n="${5:-${OPENCODE_RESUME_PREVIEW_FIRST:-15}}" last_n="${6:-${OPENCODE_RESUME_PREVIEW_LAST:-15}}"
  local db
  db="$(get_db_path)" || return 1

  validate_sid "$sid" || { echo "${color_red}Invalid session ID: $sid${color_reset}" >&2; return 1; }

  local session_info
  session_info="$(open_query "$db" "
    SELECT COALESCE(id, ''), COALESCE(slug, ''), COALESCE(title, ''), COALESCE(directory, ''),
           COALESCE(agent, ''), COALESCE(model, ''), COALESCE(time_created, 0), COALESCE(time_updated, 0),
           COALESCE(version, ''), COALESCE(parent_id, ''),
           (SELECT COUNT(*) FROM message WHERE session_id = s.id),
           (SELECT COUNT(*) FROM message WHERE session_id = s.id AND json_extract(data, '\$.role') = 'user')
    FROM session s WHERE s.id = '$sid'
  ")"

  [ -z "$session_info" ] && { echo "${color_red}Session not found: $sid${color_reset}" >&2; return 1; }

  local id slug title directory agent model_json time_created time_updated version parent_id msg_count user_msg_count
  IFS='|' read -r id slug title directory agent model_json time_created time_updated \
                         version parent_id msg_count user_msg_count <<< "$session_info"

  local model_name="?"
  if [ -n "$model_json" ]; then
    model_name="$(printf '%s' "$model_json" | sed 's/.*"id":"//; s/".*//')"
    [ -z "$model_name" ] && model_name="$(printf '%s' "$model_json" | sed 's/.*"providerID":"//; s/".*//')"
  fi

  local created_human="" updated_human=""
  [ "${time_created:-0}" -gt 0 ] && created_human="$(date -d "@$((time_created / 1000))" '+%Y-%m-%d %a %H:%M:%S' 2>/dev/null || date -r "$((time_created / 1000))" '+%Y-%m-%d %a %H:%M:%S' 2>/dev/null || echo "unknown")"
  [ "${time_updated:-0}" -gt 0 ] && updated_human="$(date -d "@$((time_updated / 1000))" '+%Y-%m-%d %a %H:%M:%S' 2>/dev/null || date -r "$((time_updated / 1000))" '+%Y-%m-%d %a %H:%M:%S' 2>/dev/null || echo "unknown")"

  local display_title="${title:-Untitled}"
  [ "$display_title" = "$slug" ] && display_title="Untitled"

  # ── Metadata header ──
  printf '%s# %s (%s)%s\n\n' "$color_bold" "$display_title" "$slug" "$color_reset"
  printf '%s**Session:**%s   \`%s\`\n' "$color_dim" "$color_reset" "$id"
  printf '%s**Slug:**%s      %s\n' "$color_dim" "$color_reset" "$slug"
  [ -n "$directory" ] && printf '%s**Directory:**%s %s\n' "$color_dim" "$color_reset" "$directory"
  [ -n "$agent" ] && printf '%s**Agent:**%s     %s\n' "$color_dim" "$color_reset" "$agent"
  [ -n "$model_name" ] && printf '%s**Model:**%s     %s\n' "$color_dim" "$color_reset" "$model_name"
  [ -n "$parent_id" ] && printf '%s**Fork of:**%s   %s\n' "$color_dim" "$color_reset" "$parent_id"
  [ -n "$version" ] && printf '%s**Version:**%s   %s\n' "$color_dim" "$color_reset" "$version"
  [ -n "$created_human" ] && printf '%s**Created:**%s  %s\n' "$color_dim" "$color_reset" "$created_human"
  [ -n "$updated_human" ] && printf '%s**Updated:**%s  %s\n' "$color_dim" "$color_reset" "$updated_human"
  printf '%s**Messages:**%s %s total, %s user\n\n' "$color_dim" "$color_reset" "${msg_count:-0}" "${user_msg_count:-0}"

  # ── Query parts with newlines escaped in SQL ──
  # sqlite3 CLI converts control chars (\x00-\x1f) to caret notation
  # (e.g., \x1e becomes ^^), so use a visible text placeholder instead.
  local RS=$'\x1f'
  local NL_PLACEHOLDER='_NL_'
  local field_sep=$'\x1f'
  local parts_data
  parts_data="$(sqlite3 -separator "$RS" "$db" "
    SELECT m.id,
           json_extract(m.data, '\$.role'),
           COALESCE(json_extract(m.data, '\$.time.created'), '0'),
           COALESCE(json_extract(m.data, '\$.agent'), ''),
           COALESCE(json_extract(m.data, '\$.modelID'), ''),
            json_extract(p.data, '\$.type'),
            REPLACE(COALESCE(json_extract(p.data, '\$.text'), ''), CHAR(10), '$NL_PLACEHOLDER'),
            COALESCE(json_extract(p.data, '\$.tool'), ''),
            COALESCE(json_extract(p.data, '\$.state.status'), ''),
            COALESCE(json_extract(p.data, '\$.callID'), ''),
            REPLACE(COALESCE(json_extract(p.data, '\$.state.input'), ''), CHAR(10), '$NL_PLACEHOLDER'),
            REPLACE(COALESCE(json_extract(p.data, '\$.state.output'), ''), CHAR(10), '$NL_PLACEHOLDER')
     FROM message m JOIN part p ON p.message_id = m.id
    WHERE m.session_id = '$sid'
    ORDER BY m.time_created, p.time_created
  " 2>/dev/null)"

  [ -z "$parts_data" ] && { printf '_(no messages)_\n'; return 0; }

  # Assemble into messages
  local msg_ids=() msg_roles=() msg_times=() msg_agents=() msg_models=()
  local msg_texts=() tool_records=() msg_tool_start=() msg_tool_end=()
  local cur_mid="" cur_role="" cur_time="" cur_agent="" cur_model="" cur_text=""
  local cur_tool_start=0

  local old_ifs="$IFS"
  IFS="$RS"
  while read -r mid role mtime agent model ptype ptext ptool pstatus pcid pinput poutput; do
    [ -z "$mid" ] && continue

    if [ "$mid" != "$cur_mid" ] && [ -n "$cur_mid" ]; then
      msg_ids+=("$cur_mid")
      msg_roles+=("$cur_role")
      msg_times+=("$cur_time")
      msg_agents+=("$cur_agent")
      msg_models+=("$cur_model")
      msg_texts+=("$cur_text")
      msg_tool_start+=("$cur_tool_start")
      msg_tool_end+=("${#tool_records[@]}")
    fi

    if [ "$mid" != "$cur_mid" ]; then
      cur_mid="$mid"
      cur_role="$role"
      cur_time="$mtime"
      cur_agent="$agent"
      cur_model="$model"
      cur_text=""
      cur_tool_start="${#tool_records[@]}"
    fi

    case "$ptype" in
      text)
        [ -n "$ptext" ] && cur_text="${cur_text}${ptext}"$'\n'
        ;;
      reasoning)
        [ "$full_mode" = "true" ] && [ -n "$ptext" ] && cur_text="${cur_text}${color_dim}∘ ${ptext}${color_reset}"$'\n'
        ;;
      tool)
        tool_records+=("${ptool}${field_sep}${pstatus}${field_sep}${pinput}${field_sep}${poutput}${field_sep}${pcid}")
        ;;
    esac
  done <<< "$parts_data"
  IFS="$old_ifs"

  # Save last message
  if [ -n "$cur_mid" ]; then
    msg_ids+=("$cur_mid")
    msg_roles+=("$cur_role")
    msg_times+=("$cur_time")
    msg_agents+=("$cur_agent")
    msg_models+=("$cur_model")
    msg_texts+=("$cur_text")
    msg_tool_start+=("$cur_tool_start")
    msg_tool_end+=("${#tool_records[@]}")
  fi

  local total_msgs="${#msg_ids[@]}"

  # Normalize boolean flags
  [ "$short_mode" = "1" ] && short_mode="true"
  [ "$full_mode" = "1" ] && full_mode="true"
  [ "$ts_mode" = "1" ] && ts_mode="true"

  # ── Short mode ──
  if [ "$short_mode" = "true" ] && [ "$total_msgs" -gt "$((first_n + last_n + 2))" ]; then
    local shown=0
    for ((i=0; i<total_msgs; i++)); do
      if [ "$i" -lt "$first_n" ] || [ "$i" -ge "$((total_msgs - last_n))" ]; then
        local srole="${msg_roles[$i]}"
        local sicon=""
        case "$srole" in
          user)      sicon="${color_user}❯${color_reset}" ;;
          assistant) sicon="${color_blue_bold}●${color_reset}" ;;
          *)         sicon=" " ;;
        esac
        local stext="${msg_texts[$i]}"
        stext="${stext%%$NL_PLACEHOLDER*}"
        stext="${stext%%$'\n'*}"
        stext="${stext:0:120}"
        [ -z "$stext" ] && stext="_(no text)_"
        printf '%s %s %s\n' "$sicon" "${srole^}" "$stext"
        shown=$((shown + 1))
      fi
    done
    if [ "$shown" -lt "$total_msgs" ]; then
      printf '%s  … (%d messages hidden) …%s\n' "$color_skipped" "$((total_msgs - shown))" "$color_reset"
    fi
    return 0
  fi

  # ── Full / conversation mode ──
  local RS=$'\x1f'

  for ((i=0; i<total_msgs; i++)); do
    local mrole="${msg_roles[$i]}"
    local mtime="${msg_times[$i]}"
    local magent="${msg_agents[$i]}"
    local mmodel="${msg_models[$i]}"
    local mtext="${msg_texts[$i]}"

    [ "$i" -gt 0 ] && printf '\n'

    local icon label
    case "$mrole" in
      user)
        icon="${color_user}❯${color_reset}"
        label="${color_user}User${color_reset}"
        [ -n "$magent" ] && label="${label} ${color_dim}(${magent})${color_reset}"
        ;;
      assistant)
        icon="${color_blue_bold}●${color_reset}"
        label="Assistant"
        [ -n "$color_assistant" ] && label="${color_assistant}${label}${color_reset}"
        [ -n "$mmodel" ] && label="${label} ${color_dim}(${mmodel})${color_reset}"
        ;;
      *)
        icon=" "
        label="$mrole"
        ;;
    esac

    if [ "$ts_mode" = "true" ] && [ -n "$mtime" ] && [ "$mtime" -gt 0 ]; then
      local ts
      ts="$(date -d "@$((mtime / 1000))" '+%Y-%m-%d %a %H:%M:%S' 2>/dev/null || date -r "$((mtime / 1000))" '+%Y-%m-%d %a %H:%M:%S' 2>/dev/null || echo "")"
      label="${label} ${color_timestamp}[${ts}]${color_reset}"
    fi

    printf '%s %s\n' "$icon" "$label"

    if [ -n "$mtext" ]; then
      printf '%s\n' "$(printf '%s' "$mtext" | sed 's/_NL_/\n/g')" | sed 's/^/  /'
    fi

    # Show tool parts if full_mode
    if [ "$full_mode" = "true" ]; then
      local t_start="${msg_tool_start[$i]}"
      local t_end="${msg_tool_end[$i]}"
      if [ "$t_end" -gt "$t_start" ]; then
        printf '\n'
        for ((j=t_start; j<t_end; j++)); do
          local tool_rec="${tool_records[$j]}"
          local old_ifs2="$IFS"
          IFS=$'\x1f'
          set -f
          local tool_fields=($tool_rec)
          set +f
          IFS="$old_ifs2"
          local tname="${tool_fields[0]}"
          local tstatus="${tool_fields[1]}"
          local tinput="${tool_fields[2]}"
          local toutput="${tool_fields[3]}"
          local tcid="${tool_fields[4]}"
          [[ "$tinput" == *"$NL_PLACEHOLDER"* ]] && tinput="$(printf '%s' "$tinput" | sed 's/_NL_/\n/g')"
          [[ "$toutput" == *"$NL_PLACEHOLDER"* ]] && toutput="$(printf '%s' "$toutput" | sed 's/_NL_/\n/g')"
          local status_color="$color_tool_tag"
          [ "$tstatus" = "error" ] && status_color="$color_red"
          printf '  %s∘ %s%s [%s]%s\n' "$color_dim" "$tname" "$color_reset" "$status_color$tstatus$color_reset" "$color_reset"
          if [ -n "$tinput" ] && [ "$tinput" != "null" ]; then
            printf '    %sInput:%s\n' "$color_tool_use" "$color_reset"
            local input_pretty
            if command -v python3 >/dev/null 2>&1; then
              input_pretty="$(printf '%s' "$tinput" | python3 -m json.tool 2>/dev/null)" || input_pretty=""
            fi
            if [ -z "$input_pretty" ] && command -v python >/dev/null 2>&1; then
              input_pretty="$(printf '%s' "$tinput" | python -m json.tool 2>/dev/null)" || input_pretty=""
            fi
            if [ -n "$input_pretty" ]; then
              local iline iline_count=0
              while IFS= read -r iline; do
                [ "$iline_count" -ge 10 ] && break
                printf '      %s\n' "$iline"
                iline_count=$((iline_count + 1))
              done <<< "$input_pretty"
            else
              local input_preview="${tinput:0:300}"
              printf '      %s\n' "$input_preview"
            fi
          fi
          if [ -n "$toutput" ] && [ "$toutput" != "null" ]; then
            local oline ocount=0
            local output_preview=""
            while IFS= read -r oline; do
              [ "$ocount" -ge 20 ] && break
              [ -n "$output_preview" ] && output_preview="$output_preview"$'\n'
              output_preview="$output_preview$oline"
              ocount=$((ocount + 1))
            done <<< "${toutput:0:2000}"
            printf '    %s── output ──%s\n' "$color_tool_result" "$color_reset"
            while IFS= read -r oline; do
              printf '      %s\n' "$oline"
            done <<< "$output_preview"
            printf '    %s────────────%s\n' "$color_tool_result" "$color_reset"
          fi
        done
      fi
    fi
  done

  printf '\n%s────────────────────────────────────────%s\n' "$color_dim" "$color_reset"
}

# ──────────────────────────────────────────────
# Mode entry points
# ──────────────────────────────────────────────

transcript_mode() {
  local sid=""
  local short_mode="${OPENCODE_RESUME_TRANSCRIPT_SHORT:-false}"
  local full_mode="${OPENCODE_RESUME_TRANSCRIPT_FULL:-false}"
  local ts_mode="${OPENCODE_RESUME_TRANSCRIPT_TIMESTAMPS:-false}"
  local first_n="${OPENCODE_RESUME_PREVIEW_FIRST:-15}"
  local last_n="${OPENCODE_RESUME_PREVIEW_LAST:-15}"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --short)         short_mode=true ;;
      --full|--with-tools|-f) full_mode=true ;;
      --timestamps|-T) ts_mode=true ;;
      --preview)       ;; # skip, used internally
      --first)         first_n="${2:-15}"; shift ;;
      --first=*)       first_n="${1#*=}" ;;
      --last)          last_n="${2:-15}"; shift ;;
      --last=*)        last_n="${1#*=}" ;;
      -*)              echo "opencode-resume: unknown transcript flag: $1" >&2; return 1 ;;
      *)               break ;;
    esac
    shift
  done

  sid="${1:-}"
  [ -z "$sid" ] && { echo "opencode-resume: --transcript needs a session id" >&2; return 1; }

  if ! validate_sid "$sid"; then
    local db resolved
    db="$(get_db_path)" || return 1
    resolved="$(open_query "$db" "SELECT id FROM session WHERE title = '$sid' OR slug = '$sid' LIMIT 1")"
    if [ -n "$resolved" ]; then
      sid="$resolved"
    else
      echo "No session found matching: $sid" >&2
      return 1
    fi
  fi

  render_transcript_impl "$sid" "$short_mode" "$full_mode" "$ts_mode" "$first_n" "$last_n" | render
}

launch_editor() {
  local editor="$1" file="$2"
  case "$editor" in
    open) open "$file" 2>/dev/null ;;
    open\ -a\ *) $editor "$file" 2>/dev/null ;;
    xdg-open) xdg-open "$file" 2>/dev/null ;;
    *) $editor "$file" </dev/tty >/dev/tty 2>&1 ;;
  esac
}

edit_mode() {
  local sid="$1"
  [ -z "$sid" ] && { echo "opencode-resume: --edit needs a session id" >&2; return 1; }

  local db
  db="$(get_db_path)" || return 1

  if ! validate_sid "$sid"; then
    local resolved
    resolved="$(open_query "$db" "SELECT id FROM session WHERE title = '$sid' OR slug = '$sid' LIMIT 1")"
    [ -z "$resolved" ] && { echo "No session found matching: $sid" >&2; return 1; }
    sid="$resolved"
  fi

  local title
  title="$(open_query "$db" "SELECT COALESCE(title, '') FROM session WHERE id = '$sid'")" || title=""

  local safe_title
  safe_title="$(printf '%s' "$title" | sed -E 's/[^[:alnum:]._-]+/-/g' | head -c 60)"
  [ -z "$safe_title" ] && safe_title="session"
  local short_sid="${sid:0:12}"
  local editdir="${XDG_DATA_HOME:-$HOME/.local/share}/opencode-resume/editor"
  mkdir -p "$editdir" 2>/dev/null
  local tmpfile="$editdir/${safe_title}-${short_sid}.md"

  # Background render while user is at the editor prompt
  render_transcript_impl "$sid" false false false > "$tmpfile" 2>/dev/null &

  # Non-TTY fallback: $EDITOR -> $VISUAL -> vi
  if [ ! -t 0 ]; then
    wait
    [ ! -s "$tmpfile" ] && { echo "Failed to render transcript" >&2; return 1; }
    local editor="${EDITOR:-${VISUAL:-vi}}"
    launch_editor "$editor" "$tmpfile" || {
      echo "Failed to open editor '$editor'" >&2
      return 1
    }
    return 0
  fi

  # Read editor preference
  local editor_config="${XDG_CONFIG_HOME:-$HOME/.config}/opencode-resume/editor"
  local chosen_editor=""
  [ -f "$editor_config" ] && chosen_editor="$(cat "$editor_config")"

  # Build shortcut table (customizable via env var)
  local shortcuts
  shortcuts="${OPENCODE_RESUME_EDITOR_SHORTCUTS:-o:xdg-open,c:code,n:nvim,v:vim,m:micro,e:emacs,b:breeze}"

  if [ -z "$chosen_editor" ]; then
    printf '\n%sChoose editor:%s\n' "$color_bold" "$color_reset"
    local IFS=','
    for entry in $shortcuts; do
      local key="${entry%%:*}" cmd="${entry#*:}"
      printf '  %s%s%s = %s  ' "$color_green" "$key" "$color_reset" "$cmd"
    done
    printf '\nEditor shortcut: '
    local reply
    IFS= read -r reply </dev/tty || reply=""
    reply="${reply:-o}"
    chosen_editor=""
    local IFS=','
    for entry in $shortcuts; do
      local key="${entry%%:*}" cmd="${entry#*:}"
      [ "$reply" = "$key" ] && { chosen_editor="$cmd"; break; }
    done
    if [ -z "$chosen_editor" ]; then
      # Single-char not in table — treat as full command
      chosen_editor="$reply"
    fi
    mkdir -p "$(dirname "$editor_config")" 2>/dev/null
    printf '%s' "$chosen_editor" > "$editor_config"
    printf '%sEditor preference saved to %s%s\n' "$color_dim" "$editor_config" "$color_reset" >&2
  fi

  wait
  [ ! -s "$tmpfile" ] && { echo "Failed to render transcript" >&2; return 1; }

  printf '%sOpening transcript in %s...%s\n' "$color_dim" "$chosen_editor" "$color_reset" >&2
  launch_editor "$chosen_editor" "$tmpfile" || {
    echo "Failed to open editor '$chosen_editor'" >&2
    return 1
  }
}

all_transcripts_mode() {
  local filter="${1:-}"
  local db
  db="$(get_db_path)" || return 1

  local sessions
  if [ -n "$filter" ]; then
    sessions="$(open_query "$db" "SELECT id, slug, title FROM session ORDER BY time_updated DESC")"
    sessions="$(printf '%s\n' "$sessions" | grep -E -i "$filter" || true)"
  else
    sessions="$(open_query "$db" "SELECT id, slug, title FROM session ORDER BY time_updated DESC")"
  fi

  [ -z "$sessions" ] && { echo "No sessions found." >&2; return 0; }

  local count=0
  while IFS='|' read -r sid slug title; do
    [ -z "$sid" ] && continue
    count=$((count + 1))
    printf '%s\n' "========================================================================"
    printf '%s[%d/%d] %s — %s%s\n' "$color_bold" "$count" "$(echo "$sessions" | wc -l)" "$title" "$slug" "$color_reset"
    printf '%s\n' "========================================================================"
    render_transcript_impl "$sid" false false false | render
    printf '\n\n'
  done <<< "$sessions"
}

get_db_path() {
  if [ -z "$OPENCODE_DB" ]; then
    local default="$HOME/.local/share/opencode/opencode.db"
    if [ -f "$default" ]; then
      OPENCODE_DB="$default"
    else
      OPENCODE_DB="$(opencode db path 2>/dev/null)" || {
        echo "opencode-resume: cannot find opencode database" >&2
        return 1
      }
    fi
  fi
  printf '%s' "$OPENCODE_DB"
}

open_query() {
  local db="$1" query="$2"
  sqlite3 "$db" "$query" 2>/dev/null
}

preview_layout_spec() {
  case "$1" in
    bottom) echo "bottom,50%,wrap,border-top" ;;
    hidden) echo "hidden" ;;
    *)      echo "right,50%,wrap,border-left" ;;
  esac
}

main() {
  check_prerequisites || return 1
  local db
  db="$(get_db_path)" || return 1
  [ ! -f "$db" ] && { echo "No opencode database at $db" >&2; return 1; }

  local cwd query
  cwd="$(pwd -P)"
  query="${*:-}"

  init_picker_state with-group

  # Preview mode file for cycling transcript view
  OPENCODE_RESUME_PREVIEW_MODE_FILE="$(mktemp -u "${TMPDIR:-/tmp}/opencode-resume-preview-mode-XXXXXX")"
  export OPENCODE_RESUME_PREVIEW_MODE_FILE
  echo conversation > "$OPENCODE_RESUME_PREVIEW_MODE_FILE" 2>/dev/null || true
  trap 'rm -f "${OPENCODE_RESUME_PREVIEW_MODE_FILE:-}"' EXIT

  local fzf_header_enter_action="resume"
  [ -n "${OPENCODE_RESUME_TRANSCRIPT_PICKER:-}" ] && fzf_header_enter_action="transcript"
  [ -n "${OPENCODE_RESUME_EDIT_PICKER:-}" ]       && fzf_header_enter_action="edit"
  local fzf_header="Enter: ${fzf_header_enter_action}   F2/CTRL-R: rename   CTRL-X: delete   CTRL-N: new   CTRL-G: toggle grouping"
  fzf_header="$fzf_header"$'\n''CTRL-S: search   CTRL-T: transcript   CTRL-E: edit   CTRL-F: cycle preview   CTRL-/: layout'

  trap ':' INT
  while :; do
    local out
    if ! out="$(
      fzf --ansi \
          --with-nth=2.. \
          --delimiter=$'\t' \
          --no-sort \
          --multi \
          --query="$query" \
          --expect=ctrl-n \
          --header="$fzf_header" \
          --preview 'opencode-resume --preview {1}' \
          --preview-window 'right,50%,wrap,border-left' \
          --bind 'focus:transform:[ -z {1} ] && echo "change-preview-window:hidden" || echo "change-preview-window:$(opencode-resume --print-preview-layout)"' \
          --bind 'ctrl-/:transform:echo "change-preview-window:$(opencode-resume --cycle-preview-layout)"' \
          --bind 'ctrl-g:execute-silent(if [ -f "$OPENCODE_RESUME_GROUP_TOGGLE" ]; then rm -f "$OPENCODE_RESUME_GROUP_TOGGLE"; else touch "$OPENCODE_RESUME_GROUP_TOGGLE"; fi)+reload-sync(opencode-resume --list)' \
          --bind 'ctrl-s:execute(opencode-resume --search {q})' \
          --bind 'ctrl-t:execute(opencode-resume --transcript --full {1} | command less -RX)' \
          --bind 'ctrl-e:execute-silent(opencode-resume --edit {1})' \
          --bind 'ctrl-f:execute-silent(opencode-resume --cycle-preview-mode)+change-preview(opencode-resume --preview {1})' \
          --bind 'pgup:preview-half-page-up,pgdn:preview-half-page-down' \
          --bind 'enter:accept-non-empty' \
          --bind 'ctrl-x:transform:N={n}; echo "execute(opencode-resume --delete-marked {+1})+clear-selection+reload-sync(opencode-resume --list)+pos($((N+1)))"' \
          --bind 'ctrl-r,f2:transform:N={n}; echo "execute(opencode-resume --rename-session {1})+reload-sync(opencode-resume --list)+pos($((N+1)))"' \
          < <(stream_list "$db" "$cwd")
    )"; then
      return 0
    fi

    parse_fzf_result "$out"
    local session_ids=("${CR_FZF_SESSION_IDS[@]+"${CR_FZF_SESSION_IDS[@]}"}")
    [ "${#session_ids[@]}" -eq 0 ] && return 0

    local target="${session_ids[${#session_ids[@]} - 1]}"
    rm -f "$OPENCODE_RESUME_PREVIEW_LAYOUT_FILE" "$OPENCODE_RESUME_GROUP_TOGGLE" "$OPENCODE_RESUME_PREVIEW_MODE_FILE"
    if [ -n "${OPENCODE_RESUME_TRANSCRIPT_PICKER:-}" ]; then
      "$0" --transcript --full "$target" | command less -RX
    elif [ -n "${OPENCODE_RESUME_EDIT_PICKER:-}" ]; then
      "$0" --edit "$target"
    else
      resume_session "$db" "$target"
    fi
    break
  done
}

# Format: pipe-separated (|) output so text fields can't break alignment.
# Each line: id|slug|title|directory|agent|model|time_created|time_updated|msg_count|first_prompt
stream_list() {
  local db="$1" cwd="$2"
  local mode="${OPENCODE_RESUME_MODE}"
  [ -f "${OPENCODE_RESUME_GROUP_TOGGLE:-/nonexistent}" ] && mode="both"

  local cutoff=0
  [ -n "$MAX_AGE" ] && [ "$MAX_AGE" -gt 0 ] 2>/dev/null && cutoff="$(cutoff_timestamp "$MAX_AGE")"

  local now
  now="$(date +%s)"

  local query="SELECT s.id, s.slug, COALESCE(s.title, ''), COALESCE(s.directory, ''), COALESCE(s.agent, ''), COALESCE(s.model, ''),
                      COALESCE(s.time_created, 0), COALESCE(s.time_updated, 0),
                      (SELECT COUNT(*) FROM message WHERE session_id = s.id),
                      COALESCE((SELECT REPLACE(REPLACE(CAST(json_extract(p.data, '$.text') AS TEXT), CHAR(9), ' '), CHAR(10), ' ')
                                FROM message sm
                                JOIN part p ON p.message_id = sm.id
                                WHERE sm.session_id = s.id
                                  AND json_extract(sm.data, '$.role') = 'user'
                                  AND json_extract(p.data, '$.type') = 'text'
                                  AND json_extract(p.data, '$.text') IS NOT NULL
                                  AND CAST(json_extract(p.data, '$.text') AS TEXT) != ''
                                ORDER BY sm.time_created, p.time_created LIMIT 1), '')
               FROM session s
               ORDER BY s.time_updated DESC"

  local sessions
  sessions="$(open_query "$db" "$query")"

  [ -z "$sessions" ] && return 0

  local line_count=0

  if [ "$mode" = "this" ]; then
    while IFS='|' read -r id slug title directory agent model time_created time_updated msg_count first_prompt; do
      [ -z "$id" ] && continue
      [ "$directory" != "$cwd" ] && continue
      [ "${time_updated:-0}" -lt "$cutoff" ] 2>/dev/null && continue
      line_count=$((line_count + 1))
      [ "$line_count" -gt "$MAX_SESSIONS" ] && break
      emit_row "$id" "$title" "$directory" "$agent" "$time_created" "$time_updated" "$msg_count" "$first_prompt" "$now" "$cwd" "" false
    done <<< "$sessions"
    return 0
  fi

  if [ "$mode" = "both" ]; then
    local cwd_rows="" other_rows=""
    while IFS='|' read -r id slug title directory agent model time_created time_updated msg_count first_prompt; do
      [ -z "$id" ] && continue
      [ "${time_updated:-0}" -lt "$cutoff" ] 2>/dev/null && continue
      line_count=$((line_count + 1))
      [ "$line_count" -gt "$MAX_SESSIONS" ] && break
      local row
      row="$(emit_row "$id" "$title" "$directory" "$agent" "$time_created" "$time_updated" "$msg_count" "$first_prompt" "$now" "$cwd" "" true)"
      if [ "$directory" = "$cwd" ]; then
        cwd_rows="${cwd_rows}${row}"$'\n'
      else
        other_rows="${other_rows}${row}"$'\n'
      fi
    done <<< "$sessions"
    if [ -n "$cwd_rows" ]; then
      printf '\t%s-- This folder --%s\n' "$color_white_bold" "$color_reset"
      printf '%s' "$cwd_rows"
    fi
    if [ -n "$other_rows" ]; then
      printf '\t%s-- Recent --%s\n' "$color_white_bold" "$color_reset"
      printf '%s' "$other_rows"
    fi
    return 0
  fi

  while IFS='|' read -r id slug title directory agent model time_created time_updated msg_count first_prompt; do
    [ -z "$id" ] && continue
    [ "${time_updated:-0}" -lt "$cutoff" ] 2>/dev/null && continue
    line_count=$((line_count + 1))
    [ "$line_count" -gt "$MAX_SESSIONS" ] && break
    emit_row "$id" "$title" "$directory" "$agent" "$time_created" "$time_updated" "$msg_count" "$first_prompt" "$now" "$cwd" "$model" false
  done <<< "$sessions"
}

# Echoes a tab-separated row: <sid>\t<display>. When return_row_only is true,
# the row is echoed (no prefix) instead of printed.
emit_row() {
  local id="$1" title="$2" directory="$3" agent="$4"
  local time_created="$5" time_updated="$6"
  local msg_count="$7" first_prompt="$8"
  local now="$9" cwd="${10}" model="${11}" return_row_only="${12:-false}"

  [ "$mode" = "this" ] && [ "$directory" != "$cwd" ] && { [ "$return_row_only" = "true" ] && echo "" || return 0; }
  # Re-read mode since emit_row is called from stream_list context
  local mode="${OPENCODE_RESUME_MODE}"
  [ -f "${OPENCODE_RESUME_GROUP_TOGGLE:-/nonexistent}" ] && mode="both"

  local folder_seq="$color_green"
  [ "$directory" = "$cwd" ] && folder_seq="$color_green_bold"

  time_created="${time_created:-0}"
  time_updated="${time_updated:-0}"
  msg_count="${msg_count:-0}"

  local age_seconds=0 age_since_first=0
  [ "$time_updated" -gt 0 ] && age_seconds=$(( (now * 1000 - time_updated) / 1000 ))
  [ "$age_seconds" -lt 0 ] && age_seconds=0
  [ "$time_created" -gt 0 ] && age_since_first=$(( (now * 1000 - time_created) / 1000 ))
  [ "$age_since_first" -lt 0 ] && age_since_first=0

  local age
  if [ "$time_created" -gt 0 ]; then
    age="$(format_age "$age_seconds") ago ($(format_age "$age_since_first"))"
  else
    age="$(format_age "$age_seconds") ago"
  fi

  local short="$directory"
  if [ -z "$short" ]; then
    short="/"
  elif [ -n "$HOME" ] && [ "${short#$HOME/}" != "$short" ]; then
    short="~/${short#$HOME/}"
  elif [ "$short" = "$HOME" ]; then
    short="~"
  fi
  if [ "${#short}" -gt 23 ]; then
    short="$(printf '%s' "$ellipsis")${short: -22}"
  fi
  short="$short/"

  local label
  if [ -n "$title" ]; then
    label="${color_yellow_bold}${title}${color_reset}"
    if [ -n "$first_prompt" ]; then
      label="${label} ${first_prompt:0:200}"
    fi
  elif [ -n "$first_prompt" ]; then
    label="${first_prompt:0:200}"
  else
    label="${color_red_bold}[empty session - safe to delete]${color_reset}"
  fi

  if [ "${#label}" -gt 200 ]; then
    label="${label:0:200}"
  fi

  local prefix=""
  [ -n "${OPENCODE_RESUME_LIST_WITH_SID:-}" ] && prefix="$id"$'\t'

  local dsp_msg
  [ "$msg_count" -gt 0 ] && dsp_msg="$(printf '%4d msgs' "$msg_count")" || dsp_msg="  0 msgs"

  local row
  row="$(printf '%s%s%-15s%s  %s%-24s%s  %s%s%s  %s' \
    "$prefix" "$color_cyan" "$age" "$color_reset" \
    "$folder_seq" "$short" "$color_reset" \
    "$color_blue_bold" "$dsp_msg" "$color_reset" "$label")"

  if [ "$return_row_only" = "true" ]; then
    printf '%s' "$row"
  else
    printf '%s\n' "$row"
  fi
}

format_age() {
  local diff=$1
  if   [ "$diff" -lt 60 ];      then printf '%2ds'  "$diff"
  elif [ "$diff" -lt 3600 ];    then printf '%2dm'  $((diff / 60))
  elif [ "$diff" -lt 86400 ];   then printf '%2dh'  $((diff / 3600))
  elif [ "$diff" -lt 604800 ];  then printf '%2dd'  $((diff / 86400))
  elif [ "$diff" -lt 2592000 ]; then printf '%2dw'  $((diff / 604800))
  else                               printf '%2dmo' $((diff / 2592000))
  fi
}

cutoff_timestamp() {
  local days="$1"
  case "$days" in ""|0|*[!0-9]*) echo 0; return ;; esac
  local cutoff
  cutoff="$(date -d "$days days ago" +%s 2>/dev/null)"
  if [ -z "$cutoff" ]; then
    cutoff="$(date -v "-${days}d" +%s 2>/dev/null)" || cutoff=0
  fi
  echo "$((cutoff * 1000))"
}

preview_session() {
  local sid="$1"
  [ -z "$sid" ] && return 0

  validate_sid "$sid" || { echo "${color_red}Invalid session ID: $sid${color_reset}" >&2; return 1; }

  local mode
  mode="$(preview_mode_file)"

  local short=false full=false
  case "$mode" in
    short) short=true ;;
    full)  full=true  ;;
  esac

  local cache_file
  cache_file="$(session_transcript_cache "$sid" "$short" "$full")"
  if [ -f "$cache_file" ]; then
    cat "$cache_file"
  else
    # Fallback: render directly
    render_transcript_impl "$sid" "$short" "$full"
  fi
}

# ──────────────────────────────────────────────
# Search mode
# ──────────────────────────────────────────────

search_cache_dir() {
  local tmpdir="${TMPDIR:-/tmp}"
  local cache_dir="$tmpdir/opencode-resume/search-cache"
  mkdir -p "$cache_dir" 2>/dev/null || true
  printf '%s' "$cache_dir"
}

search_session_cache() {
  local sid="$1"
  local cache_dir
  cache_dir="$(search_cache_dir)"

  local plain="$cache_dir/transcript-${sid}.txt"
  local colored="$cache_dir/transcript-${sid}.color.txt"

  local db
  db="$(get_db_path)" || return 1

  local session_updated
  session_updated="$(open_query "$db" "SELECT COALESCE(time_updated, 0) FROM session WHERE id = '$sid'")"

  if [ -f "$plain" ] && [ -f "$colored" ] && [ -n "$session_updated" ]; then
    local cache_mtime session_mtime
    cache_mtime="$(stat -c %Y "$plain" 2>/dev/null || echo 0)"
    session_mtime=$(( session_updated / 1000 ))
    [ "$cache_mtime" -gt "$session_mtime" ] 2>/dev/null && { printf '%s\t%s' "$plain" "$colored"; return 0; }
  fi

  render_transcript_impl "$sid" false false false > "$colored" 2>/dev/null
  sed 's/\x1b\[[0-9;]*m//g' "$colored" > "$plain" 2>/dev/null

  printf '%s\t%s' "$plain" "$colored"
}

search_count_one() {
  local sid="$1"
  shift
  [ $# -eq 0 ] && return 0

  local cache_paths
  cache_paths="$(search_session_cache "$sid")" || return 0
  local plain colored
  IFS=$'\t' read -r plain colored <<< "$cache_paths"

  [ ! -f "$plain" ] && return 0

  local terms=("$@")
  local match_lines=0
  local line text_lower

  while IFS= read -r line; do
    text_lower="$(printf '%s' "$line" | tr '[:upper:]' '[:lower:]')"
    local all_found=true
    for term in "${terms[@]}"; do
      case "$text_lower" in
        *"$term"*) ;;
        *) all_found=false; break ;;
      esac
    done
    [ "$all_found" = "true" ] && match_lines=$((match_lines + 1))
  done < "$plain"

  [ "$match_lines" -gt 0 ] || return 0
  printf '%d\t%s\n' "$match_lines" "$sid"
}

search_list() {
  local query="$*"
  [ -z "$query" ] && return 0

  local -a terms
  read -ra terms <<< "$(printf '%s' "$query" | tr '[:upper:]' '[:lower:]')"
  [ "${#terms[@]}" -eq 0 ] && return 0

  local db
  db="$(get_db_path)" || return 1

  local session_ids
  session_ids="$(open_query "$db" "SELECT id FROM session ORDER BY time_updated DESC")"
  [ -z "$session_ids" ] && return 0

  local tmpdir="${TMPDIR:-/tmp}"
  local results_file
  results_file="$(mktemp "$tmpdir/opencode-resume-search-XXXXXX")"

  printf '%s' "$session_ids" | xargs -P"$(nproc 2>/dev/null || echo 4)" -I{} "$0" --search-count {} "${terms[@]}" > "$results_file" 2>/dev/null || true

  sort -t$'\t' -k1,1 -rn "$results_file" 2>/dev/null | while IFS=$'\t' read -r count sid; do
    [ -z "$sid" ] && continue
    local session_info slug title
    session_info="$(open_query "$db" "SELECT COALESCE(slug, ''), COALESCE(title, '') FROM session WHERE id = '$sid'")"
    IFS='|' read -r slug title <<< "$session_info"
    [ -z "$title" ] && title="Untitled"
    [ "$title" = "$slug" ] && title="Untitled"
    printf '%s\t%s%4d×%s  \t%s\n' "$sid" "$color_yellow_bold" "$count" "$color_reset" "$title"
  done

  rm -f "$results_file"
}

search_preview() {
  local sid="$1"
  shift
  [ -z "$sid" ] && return 0

  local query="$*"

  local cache_paths
  cache_paths="$(search_session_cache "$sid")" || return 0
  local plain colored
  IFS=$'\t' read -r plain colored <<< "$cache_paths"

  [ ! -f "$colored" ] && return 0

  if [ -z "$query" ]; then
    cat "$colored"
    return 0
  fi

  local -a terms
  read -ra terms <<< "$(printf '%s' "$query" | tr '[:upper:]' '[:lower:]')"

  local pattern=""
  local sep=""
  for term in "${terms[@]}"; do
    local escaped
    escaped="$(printf '%s' "$term" | sed 's/[][\.*^$(){}?+|/]/\\&/g')"
    pattern="${pattern}${sep}${escaped}"
    sep="|"
  done

  # Split cache into header (metadata) and body (messages)
  local header_end
  header_end="$(grep -n '^\*\*Messages:\*\*' "$colored" 2>/dev/null | head -1 | cut -d: -f1)"
  if [ -z "$header_end" ]; then
    GREP_COLOR='07' grep -i -C 2 --color=always -E "$pattern" "$colored" 2>/dev/null || true
    return 0
  fi
  header_end=$((header_end + 2))

  # Always show the metadata header
  head -n "$header_end" "$colored"

  # Grep only the message body with context
  local grepped
  if command -v rg >/dev/null 2>&1; then
    grepped="$(tail -n +"$((header_end + 1))" "$colored" \
      | rg --color=always -i -C 2 -e "$pattern" 2>/dev/null || true)"
  else
    grepped="$(tail -n +"$((header_end + 1))" "$colored" \
      | GREP_COLOR='07' grep -i -C 2 --color=always -E "$pattern" 2>/dev/null || true)"
  fi

  # Style context-gap separators with the search-separator band
  printf '%s' "$grepped" | sed "s/^--$/${color_search_separator}──${color_reset}/"
}

main_search() {
  check_prerequisites || return 1
  local db
  db="$(get_db_path)" || return 1
  [ ! -f "$db" ] && { echo "No opencode database at $db" >&2; return 1; }

  local query="${*:-}"

  init_picker_state

  OPENCODE_RESUME_PREVIEW_MODE_FILE="$(mktemp -u "${TMPDIR:-/tmp}/opencode-resume-search-preview-mode-XXXXXX")"
  export OPENCODE_RESUME_PREVIEW_MODE_FILE
  echo "full" > "$OPENCODE_RESUME_PREVIEW_MODE_FILE" 2>/dev/null || true

  trap 'rm -f "${OPENCODE_RESUME_PREVIEW_LAYOUT_FILE:-}" "${OPENCODE_RESUME_PREVIEW_MODE_FILE:-}"' EXIT

  local fzf_header_enter_action="resume"
  [ -n "${OPENCODE_RESUME_TRANSCRIPT_PICKER:-}" ] && fzf_header_enter_action="transcript"
  [ -n "${OPENCODE_RESUME_EDIT_PICKER:-}" ]       && fzf_header_enter_action="edit"
  local fzf_header="Search — Enter: ${fzf_header_enter_action}   CTRL-X: delete   CTRL-R: rename   CTRL-F: toggle preview"
  fzf_header="$fzf_header"$'\n''CTRL-S: back to picker   CTRL-T: transcript   CTRL-E: edit'

  trap ':' INT
  while :; do
    local out
    if ! out="$(
      fzf --ansi \
          --disabled \
          --with-nth=2.. \
          --delimiter=$'\t' \
          --no-sort \
          --query="$query" \
          --header="$fzf_header" \
          --preview 'opencode-resume --search-preview {1} {q}' \
          --preview-window 'right,50%,wrap,border-left' \
          --bind 'focus:transform:[ -z {1} ] && echo "change-preview-window:hidden" || echo "change-preview-window:$(opencode-resume --print-preview-layout)"' \
          --bind 'start:reload:opencode-resume --search-list+change:reload:opencode-resume --search-list {q}' \
          --bind 'ctrl-s:abort' \
          --bind 'ctrl-f:execute-silent(opencode-resume --cycle-preview-mode)+refresh-preview' \
          --bind 'ctrl-t:execute(opencode-resume --transcript --full {1} | command less -RX)' \
          --bind 'ctrl-e:execute-silent(opencode-resume --edit {1})' \
          --bind 'enter:accept-non-empty' \
          --bind 'ctrl-x:transform:N={n}; echo "execute(opencode-resume --delete-marked {+1})+clear-selection+reload-sync(opencode-resume --search-list {q})+pos($((N+1)))"' \
          --bind 'ctrl-r,f2:transform:N={n}; echo "execute(opencode-resume --rename-session {1})+reload-sync(opencode-resume --search-list {q})+pos($((N+1)))"' \
          < /dev/null
    )"; then
      return 0
    fi

    parse_fzf_result "$out"
    local session_ids=("${CR_FZF_SESSION_IDS[@]+"${CR_FZF_SESSION_IDS[@]}"}")
    [ "${#session_ids[@]}" -eq 0 ] && return 0

    local target="${session_ids[${#session_ids[@]} - 1]}"
    rm -f "$OPENCODE_RESUME_PREVIEW_MODE_FILE"
    if [ -n "${OPENCODE_RESUME_TRANSCRIPT_PICKER:-}" ]; then
      "$0" --transcript --full "$target" | command less -RX
    elif [ -n "${OPENCODE_RESUME_EDIT_PICKER:-}" ]; then
      "$0" --edit "$target"
    else
      resume_session "$db" "$target"
    fi
    break
  done
}

resume_session() {
  local db="$1" sid="$2"
  local directory title

  directory="$(open_query "$db" "SELECT COALESCE(directory, '') FROM session WHERE id = '$sid'")" || directory=""
  title="$(open_query "$db" "SELECT COALESCE(title, '') FROM session WHERE id = '$sid'")" || title=""

  local cwd
  cwd="$(pwd -P)"
  if [ -n "$directory" ] && [ -d "$directory" ] && [ "$directory" != "$cwd" ]; then
    printf '+ cd %s\n' "$directory" >&2
    cd "$directory" || return 1
  fi

  if [ -n "${TMUX:-}" ] && [ -z "${OPENCODE_RESUME_NO_TMUX_RENAME:-}" ] && [ -n "$title" ]; then
    old_tmux_window_title="$(tmux display-message -p '#W' 2>/dev/null)"
    tmux rename-window "$(printf '%b' '\U0001f980') ${title}" 2>/dev/null
    trap 'tmux rename-window "$old_tmux_window_title" 2>/dev/null' EXIT
  fi

  printf '+ opencode -s %s\n' "$sid" >&2
  env -u OPENCODE_RESUME_PREVIEW_LAYOUT_FILE \
      -u OPENCODE_RESUME_GROUP_TOGGLE \
      -u OPENCODE_RESUME_LIST_WITH_SID \
      opencode -s "$sid"
}

rename_session() {
  local sid="$1"
  local db
  db="$(get_db_path)" || return 1

  local current
  current="$(open_query "$db" "SELECT COALESCE(title, '') FROM session WHERE id = '$sid'")"

  printf '\nRename session %s\n' "$sid" >&2
  [ -n "$current" ] && printf '  current title: %s\n' "$current" >&2
  printf 'New title (empty = cancel): ' >&2
  local title
  IFS= read -r title </dev/tty || title=""
  [ -z "$title" ] && { echo "Cancelled." >&2; return 0; }

  local escaped
  escaped="$(printf '%s' "$title" | sed "s/'/''/g")"

  sqlite3 "$db" "UPDATE session SET title = '$escaped' WHERE id = '$sid'" 2>/dev/null || {
    echo "Failed to rename session." >&2; return 1
  }

  printf '%sRenamed to: %s%s\n' "$color_yellow_bold" "$title" "$color_reset" >&2
  sleep 1
}

delete_sessions() {
  local files=()
  local db
  db="$(get_db_path)" || return 1

  printf '\nDelete the following session(s)?\n' >&2
  for sid in "$@"; do
    [ -z "$sid" ] && continue
    local title
    title="$(open_query "$db" "SELECT COALESCE(title, '') FROM session WHERE id = '$sid'")" || title=""
    printf '%s %s %s\n' "$(printf '%b' "$bullet")" "$sid" "$title" >&2
    files+=("$sid")
  done

  [ "${#files[@]}" -eq 0 ] && { echo "Nothing to delete." >&2; return 0; }

  [ "${#files[@]}" -gt 1 ] && printf '  %s(%d sessions)%s\n' "$color_bold" "${#files[@]}" "$color_reset" >&2
  printf 'Confirm delete? [Y/n]: ' >&2
  local reply
  IFS= read -r reply </dev/tty || reply=""
  case "$reply" in
    ""|y|Y|yes|YES)
      for f in "${files[@]}"; do
        opencode session delete "$f" 2>/dev/null || true
      done
      printf '%sDeleted %d session(s).%s\n' "$color_green" "${#files[@]}" "$color_reset" >&2
      sleep 1
      ;;
    *) echo "Cancelled." >&2 ;;
  esac
}

resume_by_query() {
  local query="$1"
  local db sid
  db="$(get_db_path)" || return 1

  sid="$(open_query "$db" "SELECT id FROM session WHERE id = '$query'")"
  [ -n "$sid" ] && { resume_session "$db" "$sid"; return; }

  sid="$(open_query "$db" "SELECT id FROM session WHERE title = '$query' LIMIT 1")"
  [ -n "$sid" ] && { resume_session "$db" "$sid"; return; }

  sid="$(OPENCODE_RESUME_LIST_WITH_SID=1 stream_list "$db" "$(pwd -P)" | sed 's/^[[:space:]]*//' | grep -i -F -- "$query" | head -1 | cut -f1)"
  [ -n "$sid" ] && { resume_session "$db" "$sid"; return; }

  echo "opencode-resume: no session matching '$query'" >&2
  return 1
}

check_prerequisites() {
  local missing=()
  command -v fzf     >/dev/null 2>&1 || missing+=("fzf")
  command -v sqlite3 >/dev/null 2>&1 || missing+=("sqlite3")
  command -v opencode >/dev/null 2>&1 || missing+=("opencode")


  [ "${#missing[@]}" -eq 0 ] && return 0

  printf 'opencode-resume: missing prerequisite(s): %s\n\n' "${missing[*]}" >&2
  for tool in "${missing[@]}"; do
    case "$tool" in
      fzf)     printf '  \u2022 fzf:      brew install fzf\n' >&2 ;;
      sqlite3) printf '  \u2022 sqlite3:  brew install sqlite3\n' >&2 ;;
      opencode) printf '  \u2022 opencode:  https://opencode.ai\n' >&2 ;;
    esac
  done
  return 1
}

OPENCODE_RESUME_MODE="${OPENCODE_RESUME_MODE:-recent}"
export OPENCODE_RESUME_MODE
positional=()
mode_action=""

set_mode_action() {
  if [ -n "$mode_action" ] && [ "$mode_action" != "$1" ]; then
    # -a overrides -t in either order; -t -a is the common short form -at/-ta.
    if { [ "$mode_action" = "all-transcripts" ] && [ "$1" = "transcript" ]; } \
    || { [ "$mode_action" = "transcript" ]      && [ "$1" = "all-transcripts" ]; }; then
      mode_action="all-transcripts"
      return
    fi
    # -t + -S → search picker with transcript-on-enter
    if { [ "$mode_action" = "transcript" ] && [ "$1" = "search" ]; } \
    || { [ "$mode_action" = "search" ]      && [ "$1" = "transcript" ]; }; then
      export OPENCODE_RESUME_TRANSCRIPT_PICKER=1
      mode_action="search"
      return
    fi
    echo "opencode-resume: conflicting modes: --$mode_action and --$1" >&2
    exit 2
  fi
  mode_action="$1"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    -[a-zA-Z0-9][a-zA-Z0-9]*)
      bundle="${1:1}"; shift
      exploded=()
      for ((i=0; i<${#bundle}; i++)); do exploded+=("-${bundle:$i:1}"); done
      set -- "${exploded[@]}" "$@"
      continue
      ;;
    -t|--transcript)       set_mode_action transcript ;;
    -e|--edit)             set_mode_action edit ;;
    -S|--search)           set_mode_action search ;;
    --search-list)         set_mode_action search-list ;;
    --search-preview)      set_mode_action search-preview ;;
    --search-count)        set_mode_action search-count ;;
    -a|--all-transcripts)  set_mode_action all-transcripts ;;
    --preview)             set_mode_action preview ;;
    --short)               export OPENCODE_RESUME_TRANSCRIPT_SHORT=1 ;;
    --full|--with-tools|-f) export OPENCODE_RESUME_TRANSCRIPT_FULL=1 ;;
    --timestamps|-T)       export OPENCODE_RESUME_TRANSCRIPT_TIMESTAMPS=1 ;;
    --transcript-style)    export OPENCODE_RESUME_TRANSCRIPT_STYLING="${2:-}"; shift ;;
    --transcript-style=*)  export OPENCODE_RESUME_TRANSCRIPT_STYLING="${1#*=}" ;;
    --first)               export OPENCODE_RESUME_PREVIEW_FIRST="${2:-15}"; shift ;;
    --first=*)             export OPENCODE_RESUME_PREVIEW_FIRST="${1#*=}" ;;
    --last)                export OPENCODE_RESUME_PREVIEW_LAST="${2:-15}"; shift ;;
    --last=*)              export OPENCODE_RESUME_PREVIEW_LAST="${1#*=}" ;;
    -r|--resume)           set_mode_action resume ;;
    -l|--list)             set_mode_action list ;;
    --delete-marked)       set_mode_action delete-marked ;;
    --rename-session)      set_mode_action rename-session ;;
    --cycle-preview-layout) set_mode_action cycle-preview-layout ;;
    --print-preview-layout) set_mode_action print-preview-layout ;;
    --cycle-preview-mode)   set_mode_action cycle-preview-mode ;;
    --print-preview-mode)   set_mode_action print-preview-mode ;;
    -h|--help)
      sed -nE '/opencode-resume/,/^$/ { /^$/q; s/^# ?//; p; }' "$0"
      exit 0 ;;
    -d|--here|--this)      export OPENCODE_RESUME_MODE="this" ;;
    -g|--group|--both)     export OPENCODE_RESUME_MODE="both" ;;
    --recent)              export OPENCODE_RESUME_MODE="recent" ;;
    --max-sessions)        MAX_SESSIONS="${2:-}"; shift ;;
    --max-sessions=*)      MAX_SESSIONS="${1#*=}" ;;
    --max-age-days)        MAX_AGE="${2:-}"; shift ;;
    --max-age-days=*)      MAX_AGE="${1#*=}" ;;
    --no-tmux-rename)      export OPENCODE_RESUME_NO_TMUX_RENAME=1 ;;
    *) positional+=("$1") ;;
  esac
  shift
done

export FORCE_COLOR="${FORCE_COLOR:-1}"
want_color() { [ -n "${FORCE_COLOR:-}" ] && [ "$FORCE_COLOR" != "0" ]; }
case "$OPENCODE_RESUME_TRANSCRIPT_STYLING" in
  both|chat|bat|none) ;;
  *) echo "opencode-resume: invalid OPENCODE_RESUME_TRANSCRIPT_STYLING '$OPENCODE_RESUME_TRANSCRIPT_STYLING' (both|chat|bat|none)" >&2; exit 2 ;;
esac
init_colors

case "$mode_action" in
  preview)      preview_session "${positional[0]:-}" ;;
  transcript)
    if [ -n "${positional[0]:-}" ]; then
      transcript_mode "${positional[@]}"
    else
      export OPENCODE_RESUME_TRANSCRIPT_PICKER=1
      main "${positional[@]}"
    fi
    ;;
  edit)
    if [ -n "${positional[0]:-}" ]; then
      edit_mode "${positional[0]}"
    else
      export OPENCODE_RESUME_EDIT_PICKER=1
      main "${positional[@]}"
    fi
    ;;
  all-transcripts)
    all_transcripts_mode "${positional[0]:-}" ;;
  resume)
    [ -z "${positional[0]:-}" ] && { echo "opencode-resume: --resume needs an id or title" >&2; exit 2; }
    resume_by_query "${positional[0]}" ;;
  list)
    db="$(get_db_path)" || exit 1
    stream_list "$db" "$(pwd -P)" ;;
  delete-marked) delete_sessions "${positional[@]}" ;;
  rename-session) rename_session "${positional[0]:-}" ;;
  cycle-preview-layout)
    f="${OPENCODE_RESUME_PREVIEW_LAYOUT_FILE:-/dev/null}"
    case "$(cat "$f" 2>/dev/null)" in
      bottom) echo hidden > "$f" ;;
      hidden) echo right  > "$f" ;;
      *)      echo bottom > "$f" ;;
    esac
    preview_layout_spec "$(cat "$f" 2>/dev/null)" ;;
  print-preview-layout)
    preview_layout_spec "$(cat "${OPENCODE_RESUME_PREVIEW_LAYOUT_FILE:-/dev/null}" 2>/dev/null)" ;;
  cycle-preview-mode)
    preview_mode_file cycle
    preview_mode_spec ;;
  print-preview-mode)
    preview_mode_spec ;;
  search)           main_search "${positional[@]}" ;;
  search-list)      search_list "${positional[@]}" ;;
  search-preview)   search_preview "${positional[@]}" ;;
  search-count)
    [ "${#positional[@]}" -lt 2 ] && { echo "opencode-resume: --search-count needs a session id and terms" >&2; exit 2; }
    search_count_one "${positional[@]}" ;;
  "") main "${positional[@]}" ;;
esac
